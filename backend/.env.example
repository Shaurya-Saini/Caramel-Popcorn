# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173

# --- Supabase (Postgres + Storage) ---
# From: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Service-role key — SERVER ONLY, bypasses Row Level Security. Never expose to the client.
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Google OAuth 2.0 ---
# From: Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Secret used to sign session/JWT tokens (generate a long random string)
SESSION_SECRET=change-me-to-a-long-random-string
