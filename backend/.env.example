# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173

# --- Supabase (Postgres + Storage) ---
# From: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Service-role key — SERVER ONLY, bypasses Row Level Security. Never expose to the client.
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Google OAuth 2.0 ---
# From: Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Secret used to sign session/JWT tokens (generate a long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# --- Moderation ---
# Comma-separated emails granted access to the report/moderation queue.
ADMIN_EMAILS=you@example.com

# --- Geocoding (exact-place picker when adding restaurants) ---
# PLACE SEARCH provider:
#   • If GOOGLE_MAPS_API_KEY is set → Google Places API (New) Text Search is used
#     for forward search (full POI coverage incl. every branch, like Google Maps).
#     Enable "Places API (New)" in Google Cloud Console and restrict the key to it.
#     Billing: Text Search "Pro" SKU — ~5,000 free calls/month, then ~$32/1,000.
#     We request only name/address/location (cheapest tier); search is debounced.
#   • If unset → keyless OpenStreetMap Nominatim (sparse POI coverage; misses some
#     branches). Reverse-geocode ("use my location") always uses Nominatim (free).
GOOGLE_MAPS_API_KEY=
# Nominatim base + User-Agent (used for reverse geocode, and forward when no key).
# GEOCODE_BASE_URL=https://nominatim.openstreetmap.org
GEOCODE_USER_AGENT=CaramelPopcorn/1.0 (you@example.com)
