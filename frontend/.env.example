# Base URL of the Caramel Popcorn API (include the /api prefix)
VITE_API_URL=http://localhost:4000/api

# Supabase (browser-safe publishable key) — used later for direct Storage uploads.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Static-map tile source for restaurant thumbnails ({z}/{x}/{y} template).
# Optional — defaults to keyless OpenStreetMap. For production, point this at a
# keyed provider or self-hosted tiles (OSM discourages heavy hotlinking).
# VITE_STATIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
